.SILENT :

CC = gcc
CPP = g++
Target = aspell-dist-060
ifndef Build
	Build = Debug
endif
BuildDir = $(Build)

Flags = -fPIC -w -fno-inline -fpermissive

ifeq ($(Build),Debug)
	Flags += -g
	Tag = d
	Defs = -D_DEBUG -DLINUX -D_REENTRANT -D_FILE_OFFSET_BITS=64 -DPOSIX -DASPELLDIST060_EXPORTS
	Libs =
	Inc =   -I. \
    		-I../common \
    		-I../interfaces/cc \
    		-I../linux \
    		-I../modules/speller/default
else
	Flags += -s -Os
	Defs = -DLINUX -D_REENTRANT -D_FILE_OFFSET_BITS=64 -DPOSIX -DASPELLDIST060_EXPORTS
	Libs =
	Inc =   -I. \
    		-I../common \
    		-I../interfaces/cc \
    		-I../linux \
    		-I../modules/speller/default
endif

# Dependencies
Depends =	aspell.o \
			check_funs.o \
			checker_string.o \
			affix.o \
			data.o \
			editdist.o \
			language.o \
			leditdist.o \
			multi_ws.o \
			phonet.o \
			phonetic.o \
			primes.o \
			readonly_ws.o \
			speller_impl.o \
			suggest.o \
			typo_editdist.o \
			writable.o \
			prezip.o

# Target
TargetFile = lib$(Target)$(Tag).so
$(TargetFile) : outputfolder $(Depends)
	@echo Linking $(TargetFile) [$(Build)]...
	$(CPP)$s -shared \
		-o $(BuildDir)/$(TargetFile) \
		$(addprefix $(BuildDir)/,$(Depends)) \
		$(Libs)
	@echo Done.

# Create the output folder
outputfolder :
	-mkdir -p $(BuildDir) 2> /dev/null

# Clean out targets
clean :
	rm -f $(BuildDir)/*.o $(BuildDir)/$(TargetFile)
	@echo Cleaned $(BuildDir)

