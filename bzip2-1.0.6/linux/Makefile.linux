#!/usr/bin/make
#
# This makefile generated by LgiIde
# http://www.memecode.com/lgi.php
#

.SILENT :

CC = gcc
CPP = g++
Target = bzip2
ifndef Build
	Build = Debug
endif
BuildDir = $(Build)

Flags = -fPIC -w -fno-inline -fpermissive

ifeq ($(Build),Debug)
	Flags += -g -std=c++14
	Tag = d
	Defs = -D_DEBUG -DLINUX -D_REENTRANT -D_FILE_OFFSET_BITS=64 -DPOSIX
	Libs = 
	Inc =  \
		-I..
else
	Flags += -s -Os -std=c++14
	Defs = -DLINUX -D_REENTRANT -D_FILE_OFFSET_BITS=64 -DPOSIX
	Libs = 
	Inc =  \
		-I..
endif

# Dependencies
Source =	../randtable.c \
			../huffman.c \
			../decompress.c \
			../crctable.c \
			../compress.c \
			../bzlib.c \
			../blocksort.c

SourceLst := $(patsubst %.c,%.o,$(patsubst %.cpp,%.o,$(Source)))

Objects := $(addprefix $(BuildDir)/,$(SourceLst))

# Target
TargetFile = lib$(Target)$(Tag).a
$(TargetFile) : $(Objects)
	mkdir -p $(BuildDir)
	@echo Linking $(TargetFile) [$(Build)]...
	ar rcs $(BuildDir)/$(TargetFile) $(Objects)
	@echo Done.

.SECONDEXPANSION:
$(Objects): $(BuildDir)/%.o: $$(wildcard %.c*)
	mkdir -p $(@D)
	@echo $(<F) [$(Build)]
ifeq "$(suffix $<)" ".cpp"
	$(CPP) -MMD -MP $(Inc) $(Flags) $(Defs) -c $< -o $@
else
	$(CC) -MMD -MP $(Inc) $(Flags) $(Defs) -c $< -o $@
endif

-include $(Objects:.o=.d)

# Clean out targets
clean :
	rm -rf $(BuildDir)/* $(BuildDir)/$(TargetFile)
	@echo Cleaned $(BuildDir)

VPATH=%.cpp \
	../ \
	$(BuildDir)

